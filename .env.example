# Copy this file to .env and replace placeholder values with locally generated secrets.
# DO NOT commit .env; DO NOT use this Compose configuration on a public host.
MONGO_ROOT_USER=alga
MONGO_ROOT_PASS=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_LOCAL_JWT_SECRET
JWT_EXPIRES_IN=7d
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_MB=256
NEXT_PUBLIC_API_URL=http://localhost:4000
# Docker Compose references USERPROFILE for the Ollama data directory on Windows.
# This might need adaptation on Linux/macOS or hosts without an NVIDIA GPU.
