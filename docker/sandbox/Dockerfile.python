FROM python:3.12-slim

# Create non-root runner user
RUN useradd -m -u 1001 runner

# Install only what's needed for competitive programming
# (numpy, etc. can be added here if needed)

USER runner
WORKDIR /tmp

# The entrypoint runs code from volume mounted at /code
CMD ["sh", "-c", "python /code/solution.py < /code/stdin.txt"]
